# 开发环境变量（复制为 .env 后按本机情况修改）
#
# Zotero 可执行文件路径（Windows 用 \\ 转义）
ZOTERO_PLUGIN_ZOTERO_BIN_PATH = C:\\Program Files\\Zotero\\zotero.exe

# 开发用 profile 路径。
# 强烈建议新建独立 profile，不要用日常文献库：
#   1) 关闭 Zotero
#   2) 运行 "C:\Program Files\Zotero\zotero.exe" -p 打开 profile 管理器
#   3) 新建一个 profile（例如 dsh-dev），然后用 -p dsh-dev 启动一次以生成目录
#   4) 把该 profile 的绝对路径填到下面
# 参考：https://www.zotero.org/support/kb/profile_directory
ZOTERO_PLUGIN_PROFILE_PATH = C:\\path\\to\\dev-profile

# 数据目录；留空则使用该 profile 的默认数据目录
ZOTERO_PLUGIN_DATA_DIR =

# 自定义结束 Zotero 进程的命令（一般不需要）
# ZOTERO_PLUGIN_KILL_COMMAND =

# 发布到 GitHub Releases 时需要
# GITHUB_TOKEN =
