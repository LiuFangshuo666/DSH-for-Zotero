# ── 操作系统 ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 依赖 ────────────────────────────────────────────────────
node_modules/
# 本仓库用 npm（package-lock.json 已入库）——
# 其它包管理器的锁文件一律忽略，避免同一依赖树出现两份事实来源
pnpm-lock.yaml
yarn.lock
bun.lockb

# ── 构建产物 ────────────────────────────────────────────────
# xpi 与中间产物都在这里；需要时用 `npm run build` 重新生成
.scaffold/
build/
lib/
dist/
# TypeScript 增量编译信息
*.tsbuildinfo

# ── 测试中间产物 ────────────────────────────────────────────
# 由 `npm run test:unit` 打包生成（每次重新生成，不入库）
test/unit/.build/
coverage/

# ── 本机缓存（构建工具用）────────────────────────────────────
.swc-cache/
.npm-cache/
.eslintcache

# ── 本地环境与密钥 ──────────────────────────────────────────
# .env 存的是**本机**的 Zotero 可执行文件与开发 profile 路径，不该入库；
# 需要时从 .env.example 复制一份
.env
.env.local
.env.*.local

# ── 编辑器 / IDE ────────────────────────────────────────────
.idea/
*.swp
*.swo
*~

# ── 日志与临时文件 ──────────────────────────────────────────
logs/
*.log
# 开发脚本偶尔在仓库根留下的临时结果
zotero-full.txt
*.tmp
