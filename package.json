{
  "name": "dsh-for-zotero",
  "type": "module",
  "version": "0.22.2",
  "description": "Read papers with the DeepSeek Harness agent inside Zotero",
  "config": {
    "addonName": "DSH-for-Zotero",
    "addonID": "dsh-for-zotero@zotero.cn",
    "addonRef": "dshforzotero",
    "addonInstance": "DSHForZotero",
    "prefsPrefix": "extensions.zotero.dshforzotero"
  },
  "author": "DSH-for-Zotero contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiuFangshuo666/DSH-for-Zotero.git"
  },
  "bugs": {
    "url": "https://github.com/LiuFangshuo666/DSH-for-Zotero/issues"
  },
  "homepage": "https://github.com/LiuFangshuo666/DSH-for-Zotero#readme",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "update:json": "node tools/make-update-json.mjs",
    "test": "zotero-plugin test",
    "test:unit": "esbuild test/unit/entry.ts --bundle --format=esm --platform=neutral --outfile=test/unit/.build/unit-entry.mjs && mocha \"test/unit/*.test.mjs\"",
    "verify": "npm run build && npm run update:json && npm run test:unit && node tools/verify-bundle.mjs",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
